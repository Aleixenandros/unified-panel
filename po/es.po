#: prefs.js:47 prefs.js:320 lib/unifiedPanel.js:226
msgid "Notifications"
msgstr "Notificaciones"

#: prefs.js:48
msgid "Notification list"
msgstr "Lista de notificaciones"

#: prefs.js:52 prefs.js:309
msgid "Calendar"
msgstr "Calendario"

#: prefs.js:53
msgid "With events, world clocks and weather"
msgstr "Con eventos, relojes del mundo y tiempo"

#: prefs.js:78 prefs.js:83
msgid "Layout"
msgstr "Disposición"

#: prefs.js:84
msgid "Start from a preset and adjust it below. The panel changes as you go."
msgstr ""
"Parte de un diseño predefinido y ajústalo debajo. El panel cambia al momento."

#: prefs.js:89
msgid "Preset"
msgstr "Diseño"

#: prefs.js:91
msgid "Custom"
msgstr "Personalizado"

#: prefs.js:96
msgid "Columns"
msgstr "Columnas"

#: prefs.js:97
msgid "One"
msgstr "Una"

#: prefs.js:97
msgid "Two"
msgstr "Dos"

#: prefs.js:177 prefs.js:289
msgid "Left column"
msgstr "Columna izquierda"

#: prefs.js:178 prefs.js:290
msgid "Right column"
msgstr "Columna derecha"

#: prefs.js:179 prefs.js:183 prefs.js:296
msgid "Not shown"
msgstr "No se muestra"

#: prefs.js:182
msgid "Column"
msgstr "Columna"

#: prefs.js:185
msgid ""
"Notifications and calendar not shown here stay in the clock menu. Without "
"the Now Playing card, players show up in the notification list."
msgstr ""
"Las notificaciones y el calendario que no se muestren aquí siguen en el menú "
"del reloj. Sin la tarjeta «Reproduciendo», los reproductores aparecen en la "
"lista de notificaciones."

#: prefs.js:200
msgid "Empty column"
msgstr "Columna vacía"

#: prefs.js:201
msgid "Move a block here with its menu"
msgstr "Mueve un bloque aquí con su menú"

#: prefs.js:215
msgid ""
"Use the menu of each block to change its column, and the arrows to change "
"its place in the column."
msgstr ""
"Usa el menú de cada bloque para cambiarlo de columna y las flechas para "
"cambiar su posición dentro de ella."

#: prefs.js:216
msgid "Use the arrows to change the order of the blocks."
msgstr "Usa las flechas para cambiar el orden de los bloques."

#: prefs.js:254
msgid "Move up"
msgstr "Subir"

#: prefs.js:255
msgid "Move down"
msgstr "Bajar"

#: prefs.js:292
msgid "Shown"
msgstr "Se muestra"

#: prefs.js:304
msgid "Panel"
msgstr "Panel"

#: prefs.js:310
msgid "Sections below the calendar when it is in the panel."
msgstr "Secciones bajo el calendario cuando está en el panel."

#: prefs.js:314
msgid "Events"
msgstr "Eventos"

#: prefs.js:314
msgid "Appointments of the selected day"
msgstr "Citas del día seleccionado"

#: prefs.js:316
msgid "World clocks"
msgstr "Relojes del mundo"

#: prefs.js:316
msgid "Set them up in the Clocks app"
msgstr "Se configuran en la aplicación Relojes"

#: prefs.js:318
msgid "Weather"
msgstr "Tiempo"

#: prefs.js:318
msgid "Set the location in the Weather app"
msgstr "La ubicación se elige en la aplicación Meteorología"

#: prefs.js:323
msgid "Title"
msgstr "Título"

#: prefs.js:323
msgid "“Notifications” above the list"
msgstr "«Notificaciones» encima de la lista"

#: prefs.js:325
msgid "Hide unread dot"
msgstr "Ocultar punto de no leídas"

#: prefs.js:325
msgid "The dot next to the top bar clock"
msgstr "El punto junto al reloj de la barra superior"

#: prefs.js:330
msgid "Date format"
msgstr "Formato de la fecha"

#. Translators: header date format (GLib strftime syntax), e.g. "Wednesday, November 4"
#: prefs.js:330 lib/clockHeader.js:56
msgid "%A, %B %-d"
msgstr "%A, %-d de %B"

#: prefs.js:339
msgid "Clock"
msgstr "Reloj"

#: prefs.js:344
msgid "Top bar clock"
msgstr "Reloj de la barra superior"

#: prefs.js:345
msgid "Show the date and time in the top bar with your own format."
msgstr "Muestra la fecha y la hora en la barra superior con tu propio formato."

#: prefs.js:351
msgid "“Date Menu Formatter” is enabled"
msgstr "«Date Menu Formatter» está activada"

#: prefs.js:352
msgid "Disable one of the two clock formatters to avoid showing two clocks."
msgstr ""
"Desactiva uno de los dos formateadores de reloj para no mostrar dos relojes."

#: prefs.js:359
msgid "Custom format"
msgstr "Formato personalizado"

#: prefs.js:359
msgid "Replace the default clock text"
msgstr "Sustituye el texto del reloj por defecto"

#: prefs.js:361
msgid "Format"
msgstr "Formato"

#: prefs.js:366
msgid "Font size"
msgstr "Tamaño de letra"

#: prefs.js:367
msgid "In points, 0 uses the theme size"
msgstr "En puntos; 0 usa el tamaño del tema"

#: prefs.js:375
msgid "Format codes"
msgstr "Códigos de formato"

#: prefs.js:376
msgid ""
"Uses the GLib date format. Example: %a %-d %b  %H:%M. For two lines, use \\n "
"and a smaller font size (around 8 pt)."
msgstr ""
"Usa el formato de fecha de GLib. Ejemplo: %a %-d %b  %H:%M. Para dos líneas, "
"usa \\n y un tamaño de letra menor (unos 8 pt)."

#: prefs.js:412
msgid "Invalid format"
msgstr "Formato no válido"

#: lib/layout.js:27
msgid "Notifications and calendar on the left"
msgstr "Notificaciones y calendario a la izquierda"

#: lib/layout.js:32
msgid "Notifications and calendar on the right"
msgstr "Notificaciones y calendario a la derecha"

#: lib/layout.js:37
msgid "Calendar on the left, notifications with the controls"
msgstr "Calendario a la izquierda, notificaciones con los controles"

#: lib/layout.js:42
msgid "One column, calendar on top"
msgstr "Una columna, calendario arriba"

#: lib/layout.js:47
msgid "One column, notifications on top"
msgstr "Una columna, notificaciones arriba"

#: lib/layout.js:52
msgid "Controls only"
msgstr "Solo controles"

#: lib/mediaCard.js:57
msgid "Open media player"
msgstr "Abrir el reproductor"

#: lib/mediaCard.js:89
msgid "Switch media player"
msgstr "Cambiar de reproductor"

#: lib/mediaCard.js:101
msgid "Previous track"
msgstr "Pista anterior"

#: lib/mediaCard.js:103
msgid "Play or pause"
msgstr "Reproducir o pausar"

#: lib/mediaCard.js:106
msgid "Next track"
msgstr "Pista siguiente"

#: lib/mediaCard.js:181
msgid "Unknown title"
msgstr "Título desconocido"
