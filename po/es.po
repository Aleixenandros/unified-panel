#: prefs.js:51
msgid ""
"Choose what is merged into the unified panel. When both the notifications "
"and the calendar are merged, clicking the clock opens the unified panel."
msgstr ""
"Elige qué se integra en el panel unificado. Si se integran las "
"notificaciones y el calendario, al pulsar el reloj se abre el panel "
"unificado."

#: prefs.js:56 lib/unifiedPanel.js:114
msgid "Notifications"
msgstr "Notificaciones"

#: prefs.js:56
msgid "Notification list, Windows style"
msgstr "Lista de notificaciones, estilo Windows"

#: prefs.js:58
msgid "Calendar"
msgstr "Calendario"

#: prefs.js:58
msgid "Calendar, events, world clocks and weather"
msgstr "Calendario, eventos, relojes mundiales y tiempo"

#: prefs.js:60
msgid "Now Playing card"
msgstr "Tarjeta «Reproduciendo»"

#: prefs.js:60
msgid ""
"Media controls, macOS style. When off, players stay in the notification list."
msgstr ""
"Controles multimedia, estilo macOS. Si se desactiva, los reproductores "
"siguen en la lista de notificaciones."

#: prefs.js:62
msgid "Large clock"
msgstr "Reloj grande"

#: prefs.js:62
